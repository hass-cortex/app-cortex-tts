#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Cortex TTS — Init oneshot
# Dev override + data dirs + discovery key + permissions
# ==============================================================================

DEV_DIR="/share/.dev/cortex-tts"

# Hot-deploy path: dev.sh drops the Python packages here and a restart picks
# them up in seconds. Only source is swapped — the virtualenv is baked into the
# image, so adding a dependency still needs `--init` and a rebuild.
#
# Only a local-source install (version "dev") reads the override. /share is
# writable by anything that can reach it, so a released image executing
# whatever is dropped there would be remote code execution with the
# Supervisor token.
#
# Both packages are swapped together. Syncing only one leaves the other at the
# image's version, which loads without complaint and behaves like the deploy
# silently did nothing.
if [ "$(bashio::addon.version 2>/dev/null || echo unknown)" = "dev" ]; then
    for pkg in cortex_speech cortex_tts; do
        if [ -d "${DEV_DIR}/src/${pkg}" ]; then
            bashio::log.warning "[DEV MODE] Loading ${pkg} from ${DEV_DIR}"
            rm -rf "/app/src/${pkg}"
            mkdir -p /app/src
            cp -r "${DEV_DIR}/src/${pkg}" "/app/src/${pkg}"
        fi
    done

    if [ -d "${DEV_DIR}/web" ]; then
        bashio::log.warning "[DEV MODE] Loading web UI from ${DEV_DIR}"
        rm -rf /app/web
        cp -r "${DEV_DIR}/web" /app/web
    fi
elif [ -d "${DEV_DIR}" ]; then
    bashio::log.info "Ignoring ${DEV_DIR}: dev override only applies to version dev"
fi

# Model bundles and reference recordings live under /data so Home Assistant's
# "remove with data" sweeps them up; they are downloaded on demand, not baked
# into the image.
mkdir -p /data/models /data/references /data/.cache/huggingface /data/.cache/numba

# The bootstrap key Supervisor discovery hands to the integration. Admins can
# rotate it from the Configuration tab — clearing the field regenerates it on
# the next restart.
if ! bashio::config.has_value 'discovery_api_key'; then
    GENERATED_KEY="$(head -c 32 /dev/urandom | base64 | tr -d '=+/\n')"
    bashio::addon.option 'discovery_api_key' "${GENERATED_KEY}"
    bashio::addon.options > /data/options.json
    bashio::log.info "Generated bootstrap API key for Home Assistant discovery"
fi

chown -R cortex-tts:cortex-tts /data 2>/dev/null || true
chown -R cortex-tts:cortex-tts /app/src /app/web 2>/dev/null || true
