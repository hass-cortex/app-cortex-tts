#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Cortex TTS — Main service
# ==============================================================================

LOG_LEVEL="$(bashio::config 'log_level')"
export LOG_LEVEL
export DATA_DIR="/data"
# Recordings are the one thing here a user made by hand: keep them on /share,
# which Home Assistant backs up and exposes over Samba, unlike /data.
export REFERENCES_DIR="/share/cortex-tts/references"
export STATIC_DIR="/app/web"
# The package is run from source, not installed, so the dev override is a
# plain directory swap with no install metadata to fall out of sync.
export PYTHONPATH="/app/src"
export PORT="8771"
export HOST="0.0.0.0"

# The key the integration receives through Supervisor discovery. Generated by
# the init oneshot when the admin has not set one.
if bashio::config.has_value 'discovery_api_key'; then
    API_KEY="$(bashio::config 'discovery_api_key')"
    export API_KEY
fi

# The service user is a system account with no writable home, so every
# library that caches under ~/.cache fails with EACCES. Point HOME and the
# specific caches at /data, which the init oneshot owns.
export HOME="/data"
export XDG_CACHE_HOME="/data/.cache"
export HF_HOME="/data/.cache/huggingface"
export NUMBA_CACHE_DIR="/data/.cache/numba"

bashio::log.info "Starting Cortex TTS"
bashio::log.info "Log level:     ${LOG_LEVEL}"
bashio::log.info "Data dir:      ${DATA_DIR}"
bashio::log.info "References:    ${REFERENCES_DIR}"
# Everything else is stored settings the app reads for itself and logs once
# it has them; see preferences.py.

cd /app || bashio::exit.nok "Cannot enter /app"
exec gosu cortex-tts /opt/venv/bin/python -m cortex_tts
