#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Service finish script
# Standard pattern from hassio-addons/app-example
# ==============================================================================
declare exit_code_container
exit_code_container=$(</run/s6-linux-init-container-results/exitcode)
readonly exit_code_container
readonly exit_code_service="${1}"
readonly exit_code_signal="${2}"
readonly service="cortex-tts"

bashio::log.info \
  "Service ${service} exited with code ${exit_code_service}" \
  "(by signal ${exit_code_signal})"

# s6 asked the service down (the app is stopping): exiting 0, or by the
# SIGTERM s6 sent, is a clean stop. uvicorn re-raises SIGTERM after its own
# graceful shutdown, so a Python app ends "by signal 15" even when it
# stopped cleanly. finish runs in the service directory.
if [[ "$(/command/s6-svstat -o wantedup . 2>/dev/null)" == "false" ]] \
  && { [[ "${exit_code_service}" -eq 0 ]] \
    || { [[ "${exit_code_service}" -eq 256 ]] && [[ "${exit_code_signal}" -eq 15 ]]; }; }; then
  bashio::log.info "Service ${service} stopped"

# Received a signal
elif [[ "${exit_code_service}" -eq 256 ]]; then
  if [[ "${exit_code_container}" -eq 0 ]]; then
    echo $((128 + exit_code_signal)) > /run/s6-linux-init-container-results/exitcode
  fi
  [[ "${exit_code_signal}" -eq 15 ]] && exec /run/s6/basedir/bin/halt

# Non-zero exit — service crashed
elif [[ "${exit_code_service}" -ne 0 ]]; then
  if [[ "${exit_code_container}" -eq 0 ]]; then
    echo "${exit_code_service}" > /run/s6-linux-init-container-results/exitcode
  fi
  exec /run/s6/basedir/bin/halt

# Zero exit — let s6 restart it
else
  bashio::log.info "Service ${service} restarting..."
fi
