#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Hojo TTS — Main service
# ==============================================================================

LOG_LEVEL="$(bashio::config 'log_level')"
export LOG_LEVEL
export DATA_DIR="/data"
export STATIC_DIR="/app/web"
# The package is run from source, not installed, so the dev override is a
# plain directory swap with no install metadata to fall out of sync.
export PYTHONPATH="/app/src"
export PORT="8771"
export HOST="0.0.0.0"

NUM_THREADS="$(bashio::config 'num_threads')"
export NUM_THREADS
MAX_LOADED_MODELS="$(bashio::config 'max_loaded_models')"
export MAX_LOADED_MODELS
DEFAULT_MODEL="$(bashio::config 'default_model')"
export DEFAULT_MODEL
PRELOAD="$(bashio::config 'preload')"
export PRELOAD
TEMPERATURE="$(bashio::config 'temperature')"
export TEMPERATURE

if bashio::config.has_value 'default_voice'; then
    DEFAULT_VOICE="$(bashio::config 'default_voice')"
    export DEFAULT_VOICE
fi

# The key the integration receives through Supervisor discovery. Generated by
# the init oneshot when the admin has not set one.
if bashio::config.has_value 'discovery_api_key'; then
    API_KEY="$(bashio::config 'discovery_api_key')"
    export API_KEY
fi

# Keep the numeric libraries inside the thread budget the user chose. BLAS and
# OpenMP each default to "one thread per core" and would otherwise oversubscribe
# the host during a synthesis that ORT is already threading.
# The service user is a system account with no writable home, so every
# library that caches under ~/.cache fails with EACCES. Point HOME and the
# specific caches at /data, which the init oneshot owns.
export HOME="/data"
export XDG_CACHE_HOME="/data/.cache"
export HF_HOME="/data/.cache/huggingface"
export NUMBA_CACHE_DIR="/data/.cache/numba"

export OMP_NUM_THREADS="${NUM_THREADS}"
export OPENBLAS_NUM_THREADS="${NUM_THREADS}"
export MKL_NUM_THREADS="${NUM_THREADS}"

bashio::log.info "Starting Hojo TTS"
bashio::log.info "Log level:     ${LOG_LEVEL}"
bashio::log.info "Threads:       ${NUM_THREADS}"
bashio::log.info "Default model: ${DEFAULT_MODEL}"
bashio::log.info "Temperature:   ${TEMPERATURE}"
bashio::log.info "Data dir:      ${DATA_DIR}"

cd /app || bashio::exit.nok "Cannot enter /app"
exec gosu hojo-tts /opt/venv/bin/python -m hojo_tts
